      "item": [
        {
          "id": "bc0514e9-5759-4399-be68-7e9040e38b40",
          "name": "Get Component Measures",
          "request": {
            "name": "Get Component Measures",
            "description": {
              "content": "Get measures (metrics) for a specific component. Returns values for requested metric keys such as coverage, bugs, vulnerabilities, code smells, duplications, and lines of code.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "measures",
                "component"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "component",
                  "value": "<string>",
                  "description": "(Required) Component key"
                },
                {
                  "disabled": false,
                  "key": "metricKeys",
                  "value": "<string>",
                  "description": "(Required) Comma-separated metric keys to retrieve"
                },
                {
                  "disabled": false,
                  "key": "branch",
                  "value": "<string>",
                  "description": "Branch name"
                },
                {
                  "disabled": false,
                  "key": "pullRequest",
                  "value": "<string>",
                  "description": "Pull request identifier"
                }
              ],
              "variable": [
                {
                  "description": "Hostname of your SonarQube instance",
                  "type": "any",
                  "value": "{{sonarqubeHost}}",
                  "key": "sonarqubeHost"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
