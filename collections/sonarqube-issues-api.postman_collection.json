    {
      "id": "1b3e87b3-b718-44f2-a65b-006aba71ddb2",
      "name": "Issues",
      "description": {
        "content": "Code issue search and management",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "60ba93e5-4f49-45ff-bcf3-9b48b0dac6a3",
          "name": "Search Issues",
          "request": {
            "name": "Search Issues",
            "description": {
              "content": "Search for code issues across projects. Supports filtering by severity, type, status, assignee, resolution, language, rule, tags, date ranges, and component scope.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "issues",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "componentKeys",
                  "value": "<string>",
                  "description": "Comma-separated list of component keys to scope the search"
                },
                {
                  "disabled": false,
                  "key": "severities",
                  "value": "<string>",
                  "description": "Comma-separated severities (INFO, MINOR, MAJOR, CRITICAL, BLOCKER)"
                },
                {
                  "disabled": false,
                  "key": "types",
                  "value": "<string>",
                  "description": "Comma-separated issue types (CODE_SMELL, BUG, VULNERABILITY, SECURITY_HOTSPOT)"
                },
                {
                  "disabled": false,
                  "key": "statuses",
                  "value": "<string>",
                  "description": "Comma-separated statuses (OPEN, CONFIRMED, REOPENED, RESOLVED, CLOSED)"
                },
                {
                  "disabled": false,
                  "key": "resolved",
                  "value": "<boolean>",
                  "description": "Filter by resolution status"
                },
                {
                  "disabled": false,
                  "key": "rules",
                  "value": "<string>",
                  "description": "Comma-separated rule keys"
                },
                {
                  "disabled": false,
                  "key": "languages",
                  "value": "<string>",
                  "description": "Comma-separated language keys"
                },
                {
                  "disabled": false,
                  "key": "p",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "disabled": false,
                  "key": "ps",
                  "value": "100",
                  "description": "Page size (max 500)"
                }
              ],
              "variable": [
                {
                  "description": "Hostname of your SonarQube instance",
                  "type": "any",
                  "value": "{{sonarqubeHost}}",
                  "key": "sonarqubeHost"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
