                {
                  "disabled": false,
                  "key": "p",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "disabled": false,
                  "key": "ps",
                  "value": "50",
                  "description": "Page size"
                }
              ],
              "variable": [
                {
                  "description": "Hostname of your SonarQube instance",
                  "type": "any",
                  "value": "{{sonarqubeHost}}",
                  "key": "sonarqubeHost"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
