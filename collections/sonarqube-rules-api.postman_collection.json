          "request": {
            "name": "Search Rules",
            "description": {
              "content": "Search for analysis rules available in SonarQube. Supports filtering by language, type, severity, quality profile, repository, and tags. Rules define the code quality and security checks performed during analysis.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rules",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Search query for rule name or key"
                },
                {
                  "disabled": false,
                  "key": "languages",
                  "value": "<string>",
                  "description": "Comma-separated language keys"
                },
                {
                  "disabled": false,
                  "key": "types",
                  "value": "<string>",
                  "description": "Comma-separated rule types"
                },
                {
                  "disabled": false,
                  "key": "severities",
