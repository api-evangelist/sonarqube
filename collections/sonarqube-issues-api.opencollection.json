{
  "opencollection": "1.0.0",
  "info": {
    "name": "SonarQube Web Issues API",
    "version": "10.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Issues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Issues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{sonarqubeHost}/api/issues/search",
            "params": [
              {
                "name": "componentKeys",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of component keys to scope the search"
              },
              {
                "name": "severities",
                "value": "",
                "type": "query",
                "description": "Comma-separated severities (INFO, MINOR, MAJOR, CRITICAL, BLOCKER)"
              },
              {
                "name": "types",
                "value": "",
                "type": "query",
                "description": "Comma-separated issue types (CODE_SMELL, BUG, VULNERABILITY, SECURITY_HOTSPOT)"
              },
              {
                "name": "statuses",
                "value": "",
                "type": "query",
                "description": "Comma-separated statuses (OPEN, CONFIRMED, REOPENED, RESOLVED, CLOSED)"
              },
              {
                "name": "resolved",
                "value": "",
                "type": "query",
                "description": "Filter by resolution status"
              },
              {
                "name": "rules",
                "value": "",
                "type": "query",
                "description": "Comma-separated rule keys"
              },
              {
                "name": "languages",
                "value": "",
                "type": "query",
                "description": "Comma-separated language keys"
              },
              {
                "name": "p",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "ps",
                "value": "",
                "type": "query",
                "description": "Page size (max 500)"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Search for code issues across projects. Supports filtering by severity, type, status, assignee, resolution, language, rule, tags, date ranges, and component scope."
        }
      ]
    }
  ],
  "bundled": true
}